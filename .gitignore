# 本地测试/临时产物（顶层以下划线开头的临时文件）
_*

# 但保留服务端函数用到的辅助目录（不能忽略）
!/api/_lib/
!/api/_lib/*

# 本地密钥（含访客/管理员密码与会话密钥，绝不入库）
.env
.env.local

# 验证脚本的截图
shot-*.png

# 导出的 Word
*.docx

# 系统文件
Thumbs.db
.DS_Store

# 站点配置（含编辑密码与云端 key，不入库；仓库里是 config.example.js 模板）
config.js

# CSDN 抓取产物（本地一次性导入用，体积大不入库）
csdn_articles.json

# 服务启动入口需要随仓库发布
!/_dev.js
.env.*
!.env.example
node_modules/
playwright-report/
test-results/
